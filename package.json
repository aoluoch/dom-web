{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "npm run type-check && npm run lint",
    "test:ci": "npm run type-check && npm run lint && npm run build",
    "clean": "rm -rf dist node_modules/.vite",
    "start": "npm run preview",
    "deploy": "./scripts/deploy.sh",
    "deploy:netlify": "./scripts/deploy.sh netlify",
    "deploy:vercel": "./scripts/deploy.sh vercel"
  },
  "dependencies": {
    "@contentful/rich-text-plain-text-renderer": "^17.1.0",
    "@contentful/rich-text-react-renderer": "^16.1.0",
    "@contentful/rich-text-types": "^17.1.0",
    "@tailwindcss/vite": "^4.1.12",
    "contentful": "^11.7.15",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.30.1",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  }
}
