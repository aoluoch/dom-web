# Contentful Configuration
VITE_CONTENTFUL_SPACE_ID=your_contentful_space_id_here
VITE_CONTENTFUL_ACCESS_TOKEN=your_contentful_access_token_here

# Optional: Contentful Preview API (for draft content)
VITE_CONTENTFUL_PREVIEW_ACCESS_TOKEN=your_contentful_preview_token_here

# Application Configuration
VITE_APP_NAME="DOM Web Application"
VITE_APP_VERSION="1.0.0"

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=your_ga_id_here

# API Configuration (if needed)
VITE_API_BASE_URL=https://api.example.com
